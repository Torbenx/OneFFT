{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "host",
      "displayName": "This machine, warnings as errors",
      "binaryDir": "${sourceDir}/build/cmake-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-Werror",
        "CMAKE_CXX_FLAGS": "-Werror"
      }
    },
    {
      "name": "android",
      "displayName": "Android AArch64, tests on a device over adb",
      "inherits": "host",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "24",
        "CMAKE_CROSSCOMPILING_EMULATOR": "${sourceDir}/scripts/android_run.sh;-"
      },
      "warnings": {"deprecated": false}
    }
  ],
  "buildPresets": [
    {"name": "host", "configurePreset": "host"},
    {"name": "android", "configurePreset": "android"}
  ],
  "testPresets": [
    {"name": "host", "configurePreset": "host", "output": {"outputOnFailure": true}},
    {"name": "android", "configurePreset": "android", "output": {"outputOnFailure": true}}
  ],
  "workflowPresets": [
    {
      "name": "host",
      "steps": [
        {"type": "configure", "name": "host"},
        {"type": "build", "name": "host"},
        {"type": "test", "name": "host"}
      ]
    },
    {
      "name": "android",
      "steps": [
        {"type": "configure", "name": "android"},
        {"type": "build", "name": "android"},
        {"type": "test", "name": "android"}
      ]
    }
  ]
}
